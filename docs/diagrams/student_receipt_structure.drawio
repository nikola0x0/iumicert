        <mxCell id="v3" value="3. Verify &lt;font face=&quot;Times New Roman&quot;&gt;&lt;i&gt;V&lt;/i&gt;&lt;/font&gt; matches &lt;font face=&quot;Courier New&quot;&gt;currentValue&lt;/font&gt; in state diff" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;spacingLeft=10;" vertex="1" parent="1">
