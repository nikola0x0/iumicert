        <mxCell id="p1" value="• &lt;b&gt;Self-contained&lt;/b&gt;: All verification data included" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#333333;spacingLeft=10;" vertex="1" parent="1">
